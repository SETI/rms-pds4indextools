    <Identification_Area>
        <logical_identifier>urn:nasa:pds:stress:imaging:jup01</logical_identifier>
        <version_id>1.0</version_id>
        <title>Jupiter, band survey</title>
    </Identification_Area>
    <Observation_Area>
        <Time_Coordinates>
            <start_date_time>2021-06-01</start_date_time>
        </Time_Coordinates>
